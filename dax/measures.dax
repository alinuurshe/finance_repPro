// Optional calculated date table.
// Create it first, relate Calendar[Date] to the transaction date, and mark it as the date table.
Calendar =
ADDCOLUMNS (
    CALENDAR (
        MIN ( 'finance_data_10000_rows'[Date] ),
        MAX ( 'finance_data_10000_rows'[Date] )
    ),
    "Year", YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMMM" ),
    "Year Month", FORMAT ( [Date], "YYYY-MM" )
)

// Suggested measures for the finance_data_10000_rows table.
// Confirm exact field names and approval logic in the PBIX model before adding these.

Total Spend =
SUM ( 'finance_data_10000_rows'[Amount] )

Transaction Count =
COUNTROWS ( 'finance_data_10000_rows' )

Average Transaction =
DIVIDE ( [Total Spend], [Transaction Count] )

Approved Spend =
CALCULATE (
    [Total Spend],
    NOT ISBLANK ( 'finance_data_10000_rows'[Approved By] )
)

Spend YTD =
TOTALYTD (
    [Total Spend],
    'Calendar'[Date]
)

